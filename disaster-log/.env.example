# UNI RAG System (사내 개발환경). 값은 .env.local 에만 기록하고 커밋하지 않는다.
UNI_BASE_URL=http://10.20.10.101:8000
UNI_ACCOUNT=
UNI_PASSWORD=
# 선호 모델 계열(부분 문자열). 비우면 available 첫 번째.
UNI_PREFER_MODEL=qwen
# 비상용: 특정 model_key 강제. 평소에는 비워둔다.
UNI_FORCE_MODEL=
# 일반 채팅(보고서/상황일지 초안) 엔드포인트 경로. openapi.json 으로 확인 후 조정.
UNI_CHAT_PATH=/chat
# SOP 생성(SSE __compn__) 엔드포인트 경로
UNI_SOP_PATH=/chat/json
# 헤더 수신 대기(초)
UNI_HEADER_TIMEOUT=60
# 접속 불가 시 로컬 대체 생성 사용 여부 (true/false)
UNI_FALLBACK=true

# 상황전파 현장 응답 저장소 (선택) — Upstash Redis REST. 미설정 시 프로세스 메모리
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
